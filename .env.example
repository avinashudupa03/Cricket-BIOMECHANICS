# Cricket Biomechanics AI - Environment Variables
#
# Copy this file to .env and adjust values for your environment.
# All variables are optional - the defaults shown here match config.py.

# ---------------------------------------------------------------------------
# Pose extraction
# ---------------------------------------------------------------------------
# Frame stride for pose detection. 1 = every frame (best quality, slowest).
# Higher values trade temporal smoothness for speed. Default: 1
CBAI_POSE_STRIDE=1

# ---------------------------------------------------------------------------
# Frame pre-processing (CLAHE contrast enhancement)
# ---------------------------------------------------------------------------
# Enable geometry-preserving CLAHE enhancement before pose detection.
# Helps on dark/low-contrast clips. Default: true
CBAI_PREPROCESS_ENABLE=true

# CLAHE clip limit. Higher = more contrast. Default: 2.0
CBAI_PREPROCESS_CLAHE_CLIP=2.0

# CLAHE grid size. Default: 8
CBAI_PREPROCESS_CLAHE_GRID=8

# ---------------------------------------------------------------------------
# Parallel processing
# ---------------------------------------------------------------------------
# Maximum number of parallel video-processing workers. Each worker loads
# its own MediaPipe + OpenCV stack (~400 MB RAM). Default: min(cpu_count, 8)
CBAI_MAX_WORKERS=4

# Per-video pipeline timeout in seconds. Default: 1800 (30 minutes)
CBAI_PIPELINE_TIMEOUT=1800

# ---------------------------------------------------------------------------
# Flask web app
# ---------------------------------------------------------------------------
# Secret key for Flask session management. MUST be changed in production.
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-in-production
